NODE_ENV=development
PORT=9000
CLIENT_URL=http://localhost:5173

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Zitadel OIDC
ZITADEL_ISSUER=https://id.example.eu
ZITADEL_API_AUDIENCE=
ZITADEL_PROJECT_ID=
# Facultatif si l'URL standard est utilisée
ZITADEL_JWKS_URI=
ZITADEL_USERINFO_URL=
ZITADEL_MANAGEMENT_API_URL=
ZITADEL_TOKEN_URL=
ZITADEL_ROLE_CLAIM=
ZITADEL_SERVICE_CLIENT_ID=
ZITADEL_SERVICE_CLIENT_SECRET=
ZITADEL_MANAGEMENT_SCOPE=
# URL publique appelée depuis l'e-mail de vérification. Conserver les variables
# ZITADEL telles quelles : {{.UserID}} et {{.Code}}.
ZITADEL_EMAIL_VERIFICATION_URL_TEMPLATE=https://api.example.eu/api/v1/auth/verify-email?userID={{.UserID}}&code={{.Code}}

# Inscription protégée
ALTCHA_HMAC_KEY=
SIGNUP_IP_HASH_KEY=
